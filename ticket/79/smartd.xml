<?xml version='1.0'?>
<!-- raw version from http://cafenate.wordpress.com/2009/02/22/setting-up-smartmontools-on-opensolaris/

guides:
http://www.sun.com/bigadmin/content/selfheal/sdev_intro.jsp
http://hub.opensolaris.org/bin/view/Community+Group+arc/SMF-policy

privileges determination
pfexec ppriv -e -D -s=file_dac_read,file_dac_write,sys_devices,proc_fork /usr/local/sbin/smartd -q never -c /etc/smartd.conf 


-->
<!DOCTYPE service_bundle SYSTEM '/usr/share/lib/xml/dtd/service_bundle.dtd.1'>
<service_bundle type='manifest' name='smartd'>
  <service
     name='system/smartd'
     type='service'
     version='1'>
    <single_instance/>

    <dependency
       name='filesystem-local'
       grouping='require_all'
       restart_on='none'
       type='service'>
      <service_fmri value='svc:/system/filesystem/local:default'/>
    </dependency>

    <dependency
       name='sendmail-client'
       grouping='optional_all'
       restart_on='none'
       type='service'>
      <service_fmri value='svc:/network/sendmail-client:default'/>
    </dependency>

    <dependency name='config_data'
            grouping='require_all'
            restart_on='restart'
            type='path'>
            <service_fmri
                value='file://localhost/etc/smartd.conf' />
    </dependency>

    <exec_method
       type='method'
       name='start'
       exec='/usr/sbin/smartd -q never'
       timeout_seconds='10'>
       <!-- anything other than never will check disks - use timeout_seconds='60' for all other options
	 - ~40 disks measured at 31 seconds-->
      <method_context>
        <method_credential
		user='root'
		group='root'
		privileges='file_dac_read,file_dac_write,sys_devices,proc_fork'
	/>
      </method_context>
    </exec_method>

    <exec_method
       type='method'
       name='stop'
       exec=':kill'
       timeout_seconds='5'>
    </exec_method>

    <exec_method
            type='method'
            name='refresh'
            exec=':kill -HUP'
            timeout_seconds='0'>
    </exec_method>

    <instance name='default' enabled='false'/>

    <stability value='Unstable'/>

    <template>
      <common_name>
        <loctext xml:lang='C'>
          SMART monitoring
        </loctext>
      </common_name>
      <documentation>
        <manpage title='smartd' section='1M' manpath='/usr/share/man'/>
        <manpage title='smartd.conf' section='4' manpath='/usr/share/man'/>
      </documentation>
    </template>
  </service>

</service_bundle>
